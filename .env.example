# Copy this file to .env and fill in YOUR OWN keys. NEVER commit .env (it is in .gitignore).
# The model MUST support tool calling. Copy model names from your provider's documentation.

# --- LLM, option 1: a LangChain provider: LAB_MODEL=<provider>:<model name>, plus that provider's key variable ---
LAB_MODEL=openai:<model name>
OPENAI_API_KEY=
# LAB_MODEL=anthropic:<model name>
# ANTHROPIC_API_KEY=
# LAB_MODEL=google_genai:<model name>
# GOOGLE_API_KEY=
# Optional separate tool-capable model for subagents (useful with per-model quotas).
# LAB_SUB_MODEL=google_genai:<model name>

# --- LLM, option 2: any OpenAI-compatible endpoint (OpenRouter, Together, Groq, Azure gateway, local Ollama/vLLM...) ---
# LAB_BASE_URL=https://<endpoint>/v1
# LAB_MODEL=<model name>
# LAB_API_KEY=

# Leave unset unless you need it: some reasoning models reject any non-default temperature.
# LAB_TEMPERATURE=0
# Optional per-response cap for gateways that reserve the whole context window.
# LAB_MAX_TOKENS=2048
# Optional smaller cap for each concurrently running subagent.
# LAB_SUBAGENT_MAX_TOKENS=1024
# Optional shared request rate for providers with strict per-minute quotas.
# LAB_MODEL_RPM=4.5

# --- Sandbox: Daytona (default). Create a key at https://app.daytona.io ---
DAYTONA_API_KEY=
# No Daytona account or credit left? Run the sandbox in a local Docker container instead (needs Docker; the image must
# contain python3 and bash). The container has no network; the first run pulls the image.
# SANDBOX=docker
# SANDBOX_IMAGE=python:3.12-slim

# --- Web search/fetch through the Exa MCP endpoint. Works without a key but the free tier is rate limited quickly ---
EXA_API_KEY=
